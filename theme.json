{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "graphite-950", "name": "گرافیتی تیره", "color": "#0E0E0F" },
				{ "slug": "graphite-800", "name": "گرافیتی", "color": "#1C1917" },
				{ "slug": "steel-300", "name": "استیل روشن", "color": "#B8BCC2" },
				{ "slug": "ivory-50", "name": "عاجی", "color": "#F2F0EC" },
				{ "slug": "brass-400", "name": "برنجی روشن", "color": "#C9A55C" },
				{ "slug": "brass-700", "name": "برنجی", "color": "#A16207" },
				{ "slug": "stone-50", "name": "سنگی روشن", "color": "#FAFAF9" },
				{ "slug": "stone-300", "name": "سنگی", "color": "#D6D3D1" },
				{ "slug": "ink-900", "name": "مشکی", "color": "#0C0A09" },
				{ "slug": "ink-600", "name": "خاکستری متن", "color": "#5B5F66" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1440px"
		},
		"spacing": {
			"units": [ "px", "%", "rem", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "۸", "size": "8px" },
				{ "slug": "20", "name": "۱۶", "size": "16px" },
				{ "slug": "30", "name": "۲۴", "size": "24px" },
				{ "slug": "40", "name": "۳۲", "size": "32px" },
				{ "slug": "50", "name": "۴۸", "size": "48px" },
				{ "slug": "60", "name": "۶۴", "size": "64px" },
				{ "slug": "70", "name": "۹۶", "size": "96px" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "vazirmatn",
					"name": "وزیرمتن",
					"fontFamily": "\"FV Digits\", \"Vazirmatn\", Tahoma, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Vazirmatn",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/Vazirmatn-Variable.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "کوچک", "size": "14px" },
				{ "slug": "medium", "name": "متوسط", "size": "16px" },
				{ "slug": "large", "name": "بزرگ", "size": "22px" },
				{ "slug": "x-large", "name": "خیلی بزرگ", "size": "28px" },
				{ "slug": "xx-large", "name": "تیتر", "size": "40px" }
			]
		}
	},
	"styles": {
		"color": { "background": "#FAFAF9", "text": "#0C0A09" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--vazirmatn)", "fontSize": "16px", "lineHeight": "1.8" },
		"elements": {
			"heading": { "typography": { "fontWeight": "500", "lineHeight": "1.3" } },
			"link": { "color": { "text": "#A16207" } },
			"button": {
				"border": { "radius": "0" },
				"color": { "background": "#A16207", "text": "#FFFFFF" }
			}
		}
	}
}
